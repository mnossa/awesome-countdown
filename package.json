{
  "name": "awesome-countdown",
  "version": "1.2.0",
  "description": "A customizable JavaScript countdown with lifecycle callbacks and a polished default UI",
  "main": "index.js",
  "scripts": {
    "build:demo": "esbuild index.js --bundle --platform=browser --format=iife --global-name=AwesomeCountdown --outfile=examples/awesome-countdown.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "countdown",
    "timer"
  ],
  "dependencies": {
    "moment": "^2.30.1",
    "moment-precise-range-plugin": "^1.3.0"
  },
  "author": "Matteo Nossa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnossa/awesome-countdown.git"
  },
  "homepage": "https://github.com/mnossa/awesome-countdown#readme",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
